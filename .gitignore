# === Artefactos de compilacion de .NET ===
bin/
obj/
*.user
*.suo

# === Salidas de publicacion y empaquetado ===
# Pesan cientos de MB (LibVLC + runtime self-contained) y se regeneran con build-release.ps1.
# Las releases se distribuyen adjuntas a los Releases de GitHub, no versionadas en el repo.
/publish/
/Releases/
# Copia por version de lo que se sube a cada Release de GitHub (la genera build-release.ps1).
/Publicar/

# === Material de prueba ===
# Videos usados para probar la app a mano. Son archivos pesados y no forman parte del proyecto.
/Videos/

# === Binarios nativos de FFmpeg (modo animador, decodificacion cuadro a cuadro) ===
# Las DLLs de FFmpeg (avcodec, avformat, avutil, swscale, swresample) pesan ~89 MB y no van al repo:
# son binarios de terceros, se bajan aparte. Se usa el build LGPL shared de FFmpeg 7.1 de
# BtbN/FFmpeg-Builds, quedandose solo con esas cinco. Ver THIRD-PARTY-NOTICES.md.
/ffmpeg/

# === Entorno de desarrollo ===
# Configuracion local de Claude Code: es de tu maquina, no del proyecto.
.claude/settings.local.json
.vs/
.idea/
*.swp
*~

# === Sistema operativo ===
Thumbs.db
desktop.ini
.DS_Store
