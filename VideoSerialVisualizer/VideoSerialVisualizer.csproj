<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VideoSerialVisualizer</AssemblyName>
    <RootNamespace>VideoSerialVisualizer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Se usa el Main de Program.cs en lugar del que WPF genera desde App.xaml, para poder
         ejecutar Velopack como primera instruccion del proceso (ver Program.cs). -->
    <StartupObject>VideoSerialVisualizer.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- Al desactivar EnableDefaultApplicationDefinition, el SDK pasa App.xaml a Page automaticamente:
       asi no genera su propio Main (que chocaria con el de Program.cs) pero sigue generando
       InitializeComponent(). No hace falta incluirlo a mano. -->

  <!-- Version e identidad del producto. Velopack compara esta version para decidir si hay
       actualizacion, asi que hay que subirla en cada release publicada (SemVer). -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Video Serial Visualizer</Product>
    <Description>Reproductor de series de video basado en VLC que conserva tu progreso exacto en la linea de tiempo entre sesiones, y reune carpetas enteras de videos o cursos en un solo lugar organizado.</Description>
    <Authors>David Nieves</Authors>
    <Company>David Nieves</Company>
    <Copyright>Copyright © 2026 David Nieves</Copyright>
    <!-- Solo lo consumen "dotnet pack" y los escaneres de licencias que leen el .csproj.
         En un WinExe no llega al binario: para eso esta el AssemblyMetadata de abajo. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- La GPL exige que quien recibe el binario pueda llegar al codigo fuente. Esto deja la
       licencia y la URL del repositorio dentro del ensamblado, asi el ejecutable se identifica
       solo aunque se lo separe de la carpeta que lo acompana. -->
  <ItemGroup>
    <AssemblyMetadata Include="License" Value="GPL-3.0-or-later" />
    <AssemblyMetadata Include="SourceUrl" Value="https://github.com/daveniam/Video-Serial-Visualizer" />
  </ItemGroup>

  <!-- La app es x64-only: sin esto el paquete de LibVLC copia TAMBIEN el runtime x86
       (~96 MB muertos, un 25% de la descarga). -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <!-- WinForms se usa solo para hospedar la superficie de video (WindowsFormsHost + Panel).
       Se quitan sus using implicitos para que no choquen con los tipos WPF (UserControl,
       Application, KeyEventArgs, RadioButton, etc.); se referencian con nombre calificado. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="LibVLCSharp" Version="3.9.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <!-- Etiquetas de linea de tiempo (modo animador): Markdig parsea el texto, Markdig.Wpf lo
         renderiza como FlowDocument. Markdig se referencia explicito porque se usa directo
         (MarkdownPipelineBuilder), no solo como dependencia transitiva de Markdig.Wpf. -->
    <PackageReference Include="Markdig" Version="0.22.0" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <!-- Decodificacion cuadro a cuadro exacta (modo animador). El binding es MIT y NO trae los
         binarios nativos de FFmpeg: esos se cablean aparte (build a medida de FFmpeg 7.x shared).
         Ver THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="FFMediaToolkit" Version="4.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <!-- Traducciones embebidas en el ejecutable: no hay archivos sueltos que se puedan perder
       ni rutas que resolver en tiempo de ejecucion. Ver Localization/Loc.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <!-- La GPL/LGPL exigen que la licencia y la atribucion acompañen a la copia distribuida,
       no que esten solo en el repositorio: por eso se copian junto al ejecutable.
       Lo mismo vale para las licencias de los componentes de terceros: MIT y Apache-2.0
       exigen que su texto viaje con el binario, no alcanza con nombrarlas. -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Binarios nativos de FFmpeg para el paso a cuadro exacto (modo animador). Se toman de la
       carpeta gitignorada ..\ffmpeg\ (no versionada: ver .gitignore).

       Se listan SOLO las cinco bibliotecas que el modo animador necesita de verdad (verificado
       ejecutando abrir + sondear metadata + seek + decodificar + convertir con unicamente estas):
       avfilter, avdevice y postproc tambien vienen en el build de FFmpeg pero no se usan, y pesan
       ~38 MB juntas. El comodin cubre el sufijo de version (avcodec-61, -62, ...) para que un
       cambio de version de FFmpeg no rompa silenciosamente la copia. -->
  <ItemGroup>
    <Content Include="..\ffmpeg\avcodec-*.dll;..\ffmpeg\avformat-*.dll;..\ffmpeg\avutil-*.dll;..\ffmpeg\swscale-*.dll;..\ffmpeg\swresample-*.dll"
             Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
