<UserControl x:Class="VideoSerialVisualizer.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:VideoSerialVisualizer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:VideoSerialVisualizer.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BgPrimaryBrush}"
             d:DataContext="{d:DesignInstance Type=vm:FoldersViewModel}">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{loc:Tr Explore_Title}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PillButtonStyle}" Command="{Binding AddFolderCommand}">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="18,10">
                        <TextBlock Text="{loc:Tr Explore_AddFolder}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}" Margin="10,0,0,0" Command="{Binding OpenSettingsCommand}">
                    <Border Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="8" Padding="18,10">
                        <TextBlock Text="{loc:Tr Explore_Settings}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Buscador + accesos Todas/Favoritos -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
            <Border Width="320" Background="{StaticResource BgSurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="38">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#128269;" Margin="10,0,4,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Padding="0,0,10,0" />
                        <TextBlock Text="{loc:Tr Explore_SearchFolder}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource InverseStringToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="16,0" />

            <Button Style="{StaticResource PlainButtonStyle}" Command="{Binding OpenAllCommand}" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Explore_All}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{Binding IsAllActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#F2F2F5;#9A9AA5}" />
            </Button>
            <Button Style="{StaticResource PlainButtonStyle}" Command="{Binding ShowFavoritesCommand}" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="{loc:Tr Explore_Favorites}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{Binding ShowFavoritesOnly, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#F2F2F5;#9A9AA5}" />
            </Button>

            <ItemsControl ItemsSource="{Binding CategoryTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryTabViewModel}">
                        <Button Style="{StaticResource PlainButtonStyle}" VerticalAlignment="Center" Margin="20,0,0,0"
                                Command="{Binding DataContext.SelectCategoryTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#F2F2F5;#9A9AA5}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <Grid Height="6" Width="320" HorizontalAlignment="Left" Background="{StaticResource BgSurfaceAltBrush}"
                  Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Rectangle Height="6" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3"
                           Width="{Binding ScanProgressPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=320}" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">

                <!-- Tarjetas de carpetas -->
                <ItemsControl ItemsSource="{Binding FolderCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderCardViewModel}">
                            <Border Width="240" Height="190" Margin="0,0,20,20" CornerRadius="10" Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" ClipToBounds="True"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                        <MenuItem Header="{loc:Tr Explore_RenameGroup}" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{loc:Tr Explore_AssignCategory}" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.Tag.AssignCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{loc:Tr Explore_DeleteGroup}" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="135" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.RowSpan="2" Style="{StaticResource PlainButtonStyle}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Grid Grid.Row="0" IsHitTestVisible="False">
                                        <Rectangle Fill="{StaticResource BgSurfaceAltBrush}" />
                                        <TextBlock Text="&#128193;" FontSize="30" Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                    </Grid>

                                    <Button Grid.Row="0" Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="8"
                                            Command="{Binding DataContext.ToggleFolderFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Background="#99000000" CornerRadius="13" Width="26" Height="26">
                                            <Viewbox Width="14" Height="14">
                                                <Grid>
                                                    <Path Data="{StaticResource HeartOutlineGeometry}" Fill="{StaticResource TextPrimaryBrush}"
                                                          Visibility="{Binding Favorito, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <Path Data="{StaticResource HeartFilledGeometry}" Fill="{StaticResource SeekPlayedBrush}"
                                                          Visibility="{Binding Favorito, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Button>

                                    <StackPanel Grid.Row="1" Margin="12,10,12,12" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" />
                                        <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
