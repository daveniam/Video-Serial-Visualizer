<UserControl x:Class="VideoSerialVisualizer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:VideoSerialVisualizer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:vm="clr-namespace:VideoSerialVisualizer.ViewModels"
             xmlns:helpers="clr-namespace:VideoSerialVisualizer.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
             Background="{StaticResource BgPrimaryBrush}">
    <!-- Atajos del reproductor. Solo se disparan mientras el foco de teclado de WPF esta dentro de
         este control (ver PlayerView.xaml.cs: se reclama el foco tras cada clic en el video, porque
         un clic nativo se lo lleva a la ventana hija de LibVLC). Los comandos de loop/segmento/paso
         a cuadro se auto-protegen con IsAnimatorModeEnabled, asi que quedan activos sin filtrar nada
         aca (en modo normal no hacen nada).

         Convive lo "normal de reproductor" con lo especifico del modo animador sin pisarse:
           - Flechas solas = salto de 5s; con Shift = 10s. El paso a cuadro usa Ctrl+flechas y "," ".".
           - Arriba/Abajo = volumen.
           - Espacio / K = play-pausa.
           - M = silenciar en modo normal, o agregar etiqueta en modo animador (comando MarkerOrMute). -->
    <UserControl.InputBindings>
        <!-- Base de reproductor -->
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="K" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Left" Command="{Binding SeekBackwardCommand}" />
        <KeyBinding Key="Right" Command="{Binding SeekForwardCommand}" />
        <KeyBinding Modifiers="Shift" Key="Left" Command="{Binding SeekBackwardLongCommand}" />
        <KeyBinding Modifiers="Shift" Key="Right" Command="{Binding SeekForwardLongCommand}" />
        <KeyBinding Key="Up" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Key="Down" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Key="M" Command="{Binding MarkerOrMuteCommand}" />

        <!-- Modo animador (no-op en modo normal) -->
        <KeyBinding Key="OemComma" Command="{Binding StepFrameBackwardCommand}" />
        <KeyBinding Key="OemPeriod" Command="{Binding StepFrameForwardCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Left" Command="{Binding StepFrameBackwardCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Right" Command="{Binding StepFrameForwardCommand}" />
        <KeyBinding Key="I" Command="{Binding SetSegmentStartCommand}" />
        <KeyBinding Key="O" Command="{Binding SetSegmentEndCommand}" />
        <KeyBinding Key="L" Command="{Binding ToggleLoopCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSegmentCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
             El video se renderiza en una ventana nativa de Windows embebida (HwndHost), no como
             un elemento grafico normal de WPF. Esas ventanas nativas siempre se dibujan por encima
             de cualquier control WPF con el que se superpongan, sin importar el z-order del XAML
             ("airspace problem"). Por eso el VideoView NUNCA debe compartir fila/celda con controles:
             tiene su propia fila y los controles van en filas separadas, sin superposicion.
        -->
        <Button Grid.Row="0" Style="{StaticResource BackButtonStyle}" HorizontalAlignment="Left" Margin="16"
                Command="{Binding BackCommand}" ToolTip="{loc:Tr Player_BackToLibrary}" />

        <!-- El video se aloja en una ventana nativa hija (MediaPlayer.Hwnd) via WindowsFormsHost.
             Se evita a proposito el VideoView de LibVLCSharp.WPF: ese usa una ventana superpuesta
             separada que debe seguir la posicion del control en pantalla, y con multi-monitor / DPI
             calcula mal y termina mostrando el video enorme en una ventana aparte. -->
        <!-- Tres formas de mostrar el video, mutuamente excluyentes:
               1. Ventana nativa de LibVLC: el camino rapido, con el modo animador apagado.
               2. Imagen WPF en vivo (render por callbacks): en modo animador, para que el video sea
                  contenido WPF y pueda transparentarse / llevarse a la ventana flotante.
               3. Imagen WPF del cuadro exacto de FFmpeg: mientras se revisa cuadro a cuadro. -->
        <Grid Grid.Row="1" x:Name="VideoArea" Background="Black">
            <wfi:WindowsFormsHost x:Name="VideoHost" Background="Black"
                                   Visibility="{Binding IsNativeVideoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Image Source="{Binding VideoFrame}" Stretch="Uniform"
                   Visibility="{Binding IsCallbackVideoVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                   MouseLeftButtonDown="FrameStepImage_MouseLeftButtonDown" />

            <Image Source="{Binding FrameStepImage}" Stretch="Uniform"
                   Visibility="{Binding IsFrameStepVisibleInMain, Converter={StaticResource BooleanToVisibilityConverter}}"
                   MouseLeftButtonDown="FrameStepImage_MouseLeftButtonDown" />

            <!-- Con la ventana de referencia abierta el video se dibuja SOLO alla. Sin este cartel,
                 la ventana principal quedaria en negro y pareceria que algo se rompio. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsReferenceWindowOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Viewbox Width="44" Height="44" HorizontalAlignment="Center" Opacity="0.5">
                    <Grid Width="24" Height="24">
                        <Rectangle Width="15" Height="11" Stroke="{StaticResource TextSecondaryBrush}"
                                   StrokeThickness="1.8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="1,3,0,0" />
                        <Rectangle Width="15" Height="11" Stroke="{StaticResource TextSecondaryBrush}"
                                   StrokeThickness="1.8" Fill="{StaticResource BgPrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,1,3" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="{loc:Tr Reference_PlayingInReferenceWindow}" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Boton de play grande al centro (estilo YouTube) cuando el video esta pausado.
                 Va en un Popup a proposito: el video normal se dibuja en una ventana NATIVA (ver
                 arriba, "airspace problem") que taparia cualquier control WPF superpuesto. El Popup
                 se renderiza en su propia ventana por encima, asi que aparece sobre el video en
                 cualquiera de los tres modos de dibujo. Placement=Center lo centra sobre el video.

                 Como es una ventana top-level aparte, el code-behind (PlayerView.xaml.cs) se encarga
                 de: reposicionarla cuando la ventana principal se mueve/redimensiona/restaura, y
                 marcarla WS_EX_NOACTIVATE al abrirse para que no robe la activacion. -->
            <Popup x:Name="PlayOverlayPopup"
                   PlacementTarget="{Binding ElementName=VideoArea}" Placement="Center"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None"
                   Opened="PlayOverlayPopup_Opened"
                   IsOpen="{Binding IsPlayOverlayVisible, Mode=OneWay}">
                <Button Style="{StaticResource PlainButtonStyle}" Command="{Binding PlayPauseCommand}"
                        ToolTip="{loc:Tr Player_PlayPause}" Width="72" Height="72">
                    <Grid>
                        <Ellipse Fill="#B0000000" />
                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" />
                        <!-- Triangulo de play, apenas corrido a la derecha para verse centrado. -->
                        <Path Data="M 0,0 L 22,13 L 0,26 Z" Fill="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Grid>
                </Button>
            </Popup>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" Padding="16,10,16,10">
            <StackPanel>
                <!-- Aviso breve tras fijar la portada del grupo (clic derecho en la barra). Va aca, en
                     la barra de controles (contenido WPF normal), y no sobre el video: ahi la ventana
                     nativa de LibVLC lo taparia (airspace). -->
                <Border Visibility="{Binding IsCoverFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,0,8"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CoverFeedbackText}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </Border>

                <!-- Barra del modo animador: herramientas de estudio cuadro a cuadro (paso a
                     fotograma, bucle, seleccion de segmento; las etiquetas se agregan en la fase
                     siguiente). -->
                <Border Visibility="{Binding IsAnimatorModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Paso a cuadro exacto (FFmpeg), atajos "," / "." o Ctrl+Flechas. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30"
                                Command="{Binding StepFrameBackwardCommand}" ToolTip="{loc:Tr Player_StepFrameBack}">
                            <TextBlock Text="&lt;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30" Margin="2,0,0,0"
                                Command="{Binding StepFrameForwardCommand}" ToolTip="{loc:Tr Player_StepFrameForward}">
                            <TextBlock Text="&gt;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Numero de cuadro: solo mientras se esta revisando cuadro a cuadro. -->
                        <TextBlock Text="{Binding FrameNumberText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Visibility="{Binding IsFrameStepActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Sin este aviso, los botones de arriba aparecen apagados sin motivo
                             visible y parece que la aplicacion esta fallando. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                    ToolTip="{loc:Tr Player_FrameStepUnavailableHint}"
                                    Visibility="{Binding IsFrameStepUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="&#9888;" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Tr Player_FrameStepUnavailable}" Margin="5,0,0,0"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="8,0" />

                        <!-- Bucle: repite el segmento marcado, o el video completo si no hay segmento. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30"
                                Command="{Binding ToggleLoopCommand}" ToolTip="{loc:Tr Player_Loop}">
                            <Border CornerRadius="4"
                                    Background="{Binding IsLoopEnabled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                                <Viewbox Width="16" Height="16" Margin="7">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Width="16" Height="16" Margin="4"
                                                 Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" />
                                        <Path Data="M16,2 L20,7 L13,7 Z" Fill="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="8,0" />

                        <!-- Marcar entrada / salida del segmento, en la posicion actual del video. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30"
                                Command="{Binding SetSegmentStartCommand}" ToolTip="{loc:Tr Player_SetSegmentStart}">
                            <TextBlock Text="[" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30" Margin="2,0,0,0"
                                Command="{Binding SetSegmentEndCommand}" ToolTip="{loc:Tr Player_SetSegmentEnd}">
                            <TextBlock Text="]" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Rango marcado + boton para quitarlo; solo aparece si hay un segmento. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Visibility="{Binding HasSegment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SegmentRangeText}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Button Style="{StaticResource PlainButtonStyle}" Margin="6,0,0,0" Padding="4"
                                    Command="{Binding ClearSegmentCommand}" ToolTip="{loc:Tr Player_ClearSegment}">
                                <TextBlock Text="&#10005;" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                            </Button>
                        </StackPanel>

                        <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="8,0" />

                        <!-- Nueva etiqueta en la posicion actual (atajo M). El texto admite Markdown. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30"
                                Command="{Binding AddMarkerCommand}" ToolTip="{loc:Tr Player_AddMarker}">
                            <Viewbox Width="14" Height="16">
                                <Path Data="M0,0 L12,0 L12,20 L6,14 L0,20 Z" Fill="{StaticResource TextPrimaryBrush}" />
                            </Viewbox>
                        </Button>

                        <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="8,0" />

                        <!-- Ventana de referencia flotante: saca el video a una ventana propia,
                             semitransparente y siempre encima, para calcar sobre otro programa. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="30" Height="30"
                                Command="{Binding ToggleReferenceWindowCommand}" ToolTip="{loc:Tr Reference_Toggle}">
                            <Border CornerRadius="4"
                                    Background="{Binding IsReferenceWindowOpen, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                                <Viewbox Width="16" Height="16" Margin="7">
                                    <Grid Width="24" Height="24">
                                        <Rectangle Width="15" Height="11" Stroke="{StaticResource TextPrimaryBrush}"
                                                   StrokeThickness="1.8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="1,3,0,0" />
                                        <Rectangle Width="15" Height="11" Stroke="{StaticResource TextPrimaryBrush}"
                                                   StrokeThickness="1.8" Fill="{StaticResource BgSurfaceAltBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,1,3" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Barra de progreso. En modo animador se agranda (SeekBarContainerHeight/
                     SeekBarTrackHeight) para que la division en cuadros de abajo sea evidente. -->
                <Grid Height="{Binding SeekBarContainerHeight}">
                    <Grid VerticalAlignment="Center" Height="{Binding SeekBarTrackHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Inverse}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{StaticResource SeekPlayedBrush}" />
                        <Rectangle Grid.Column="1" Fill="{StaticResource SeekTrackBrush}" />
                    </Grid>

                    <!-- Banda del segmento marcado, superpuesta sobre el fondo de la barra. No es
                         interactiva: el Slider (declarado despues) sigue quedando arriba para arrastrar. -->
                    <Grid VerticalAlignment="Center" Height="{Binding SeekBarTrackHeight}" IsHitTestVisible="False"
                          Visibility="{Binding HasSegment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding SegmentStartPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                            <ColumnDefinition Width="{Binding SegmentBandWidthPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                            <ColumnDefinition Width="{Binding SegmentAfterPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="1" Fill="{StaticResource AccentBrush}" Opacity="0.5" />
                    </Grid>

                    <!-- Marcas de cuadro (modo animador): divide la barra en VisibleFrameTickCount
                         columnas iguales y dibuja una linea fina en el borde de cada una, para que se
                         vea que el timeline esta hecho de cuadros discretos y no es continuo. En un
                         video largo cada marca pasa a representar varios cuadros (ver MaxVisibleFrameTicks
                         en el ViewModel): no hay forma de dibujar un pixel por cada uno de miles de
                         cuadros y que siga siendo distinguible. -->
                    <ItemsControl ItemsSource="{Binding FrameTickIndexes}" IsHitTestVisible="False"
                                  VerticalAlignment="Center" Height="{Binding SeekBarTrackHeight}"
                                  Visibility="{Binding HasFrameTicks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding VisibleFrameTickCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Dos capas: el relleno amarillo (opaco, solo en la marca de inicio
                                     o fin del segmento) y la linea divisoria (sutil, siempre presente,
                                     incluso sobre el relleno). Separadas para que el relleno no herede
                                     la opacidad baja de la linea. -->
                                <Grid>
                                    <Border>
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource TickHighlightConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.SegmentStartTickIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="DataContext.SegmentEndTickIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Border BorderBrush="Black" BorderThickness="1,0,0,0" Opacity="0.35" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Perilla (dot) en la cabeza de reproduccion: se ubica en el borde del relleno
                         repartiendo el ancho igual que la barra. No intercepta clics. -->
                    <Grid VerticalAlignment="Center" Height="{Binding SeekBarTrackHeight}" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Inverse}" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="13" Height="13" Fill="{StaticResource SeekPlayedBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0" />
                    </Grid>

                    <!-- Capa interactiva de arrastre: reemplaza al Slider de WPF. Cubre toda la barra,
                         calcula el punto por la X del cursor (clic = salto exacto, arrastre = seek en
                         vivo). Va antes de los marcadores para que ellos queden arriba y reciban su clic.
                         Clic derecho: registra el punto (RightDownCommand) y abre el menu para fijar la
                         portada del grupo con el cuadro de ese momento. -->
                    <Border Background="Transparent" Cursor="Hand"
                            helpers:ScrubBar.IsEnabled="True"
                            helpers:ScrubBar.BeginCommand="{Binding ScrubBeginCommand}"
                            helpers:ScrubBar.UpdateCommand="{Binding ScrubUpdateCommand}"
                            helpers:ScrubBar.EndCommand="{Binding ScrubEndCommand}"
                            helpers:ScrubBar.RightDownCommand="{Binding RecordCoverPointCommand}">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Tr Cover_SetAsGroupCover}"
                                          Command="{Binding SetGroupCoverCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>

                    <!-- Etiquetas de linea de tiempo (modo animador): un rombo en la posicion exacta
                         de cada marca, con vista previa Markdown al pasar el mouse. Van DESPUES del
                         Slider en el XAML para quedar arriba en el z-order: sin esto, el Slider (que
                         cubre toda la barra para el clic-a-punto) interceptaria los clics que apuntan
                         a un marcador puntual en vez de dejarselos al boton del marcador. -->
                    <ItemsControl ItemsSource="{Binding Markers}" Height="{Binding SeekBarContainerHeight}"
                                  Visibility="{Binding IsAnimatorModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding DataContext.MarkerVerticalOffset, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource PercentToCanvasLeftConverter}">
                                            <Binding Path="Percent" />
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Clic izquierdo = saltar a la marca; clic derecho = editar/eliminar.
                                     Evita a proposito la ambiguedad clic-simple-vs-doble-clic de WPF. -->
                                <!-- InitialShowDelay: WPF espera 400ms por defecto antes de mostrar
                                     cualquier tooltip; para revisar etiquetas al vuelo eso se siente
                                     lento, asi que se baja casi a cero.
                                     ShowDuration: por defecto el tooltip se auto-oculta a los 5s, muy
                                     poco para leer una nota larga; se extiende a un minuto. -->
                                <Button Style="{StaticResource PlainButtonStyle}" Width="12" Height="14" Cursor="Hand"
                                        Margin="-6,0,0,0"
                                        ToolTipService.InitialShowDelay="100"
                                        ToolTipService.ShowDuration="60000"
                                        Command="{Binding DataContext.JumpToMarkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <!-- RichTextBox.Document NO es una DependencyProperty (FlowDocument
                                                 tiene semantica de "un solo dueno"): bindearla directo tira
                                                 "A 'Binding' cannot be set on the 'Document' property...". Se
                                                 usa la propiedad adjunta de RichTextBoxHelper como puente. -->
                                            <RichTextBox IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         Foreground="{StaticResource TextPrimaryBrush}" IsDocumentEnabled="True"
                                                         helpers:RichTextBoxHelper.BoundDocument="{Binding RenderedDocument, Mode=OneWay}" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                            <MenuItem Header="{loc:Tr Marker_Edit}" Style="{StaticResource DarkMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.EditMarkerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Tr Marker_Delete}" Style="{StaticResource DarkMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteMarkerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Path Data="M6,0 L12,7 L6,14 L0,7 Z" Fill="{StaticResource AccentBrush}"
                                          Stroke="Black" StrokeThickness="0.75" Stretch="Uniform" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Controles -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PlayPreviousCommand}"
                            IsEnabled="{Binding HasPreviousVideo}" ToolTip="{loc:Tr Player_PreviousVideo}">
                        <Viewbox Width="17" Height="17">
                            <Path Data="{StaticResource SkipPreviousGeometry}" Fill="{StaticResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PlayPauseCommand}"
                            ToolTip="{loc:Tr Player_PlayPause}">
                        <TextBlock Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding PlayNextCommand}"
                            IsEnabled="{Binding HasNextVideo}" ToolTip="{loc:Tr Player_NextVideo}">
                        <Viewbox Width="17" Height="17">
                            <Path Data="{StaticResource SkipNextGeometry}" Fill="{StaticResource TextPrimaryBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding ToggleMuteCommand}"
                            ToolTip="{loc:Tr Player_Mute}">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Path Data="{StaticResource VolumeSpeakerGeometry}" Fill="{StaticResource TextPrimaryBrush}" />
                                <Path Data="{StaticResource VolumeWavesGeometry}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsMuted, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <Path Data="{StaticResource VolumeMuteXGeometry}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Viewbox>
                    </Button>

                    <!-- ClipToBounds: la perilla (dot) al 100% queda justo en el borde; el recorte
                         evita que sobresalga hacia el boton de al lado. -->
                    <Grid Grid.Column="4" Width="80" Height="20" VerticalAlignment="Center" Margin="2,0,0,0"
                          ClipToBounds="True">
                        <Grid VerticalAlignment="Center" Height="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Volume, Converter={StaticResource PercentToGridLengthConverter}}" />
                                <ColumnDefinition Width="{Binding Volume, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Inverse}" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" />
                            <Rectangle Grid.Column="1" Fill="{StaticResource SeekTrackBrush}" RadiusX="2" RadiusY="2" />
                        </Grid>

                        <!-- Perilla del volumen en el borde del relleno. Sin margen negativo: se apoya
                             contra el borde para no desbordar; el recorte del contenedor la contiene. -->
                        <Grid VerticalAlignment="Center" Height="11" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Volume, Converter={StaticResource PercentToGridLengthConverter}}" />
                                <ColumnDefinition Width="{Binding Volume, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Inverse}" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="1" Width="11" Height="11" Fill="{StaticResource AccentBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5.5,0,0,0" />
                        </Grid>

                        <!-- Capa interactiva: reemplaza al Slider (mismo motivo que la barra de progreso). -->
                        <Border Background="Transparent" Cursor="Hand" ToolTip="{loc:Tr Player_Volume}"
                                helpers:ScrubBar.IsEnabled="True"
                                helpers:ScrubBar.UpdateCommand="{Binding SetVolumeFractionCommand}" />
                    </Grid>

                    <Button Grid.Column="5" Style="{StaticResource PlayerIconButtonStyle}" Command="{Binding ToggleSubtitlesCommand}"
                            ToolTip="{loc:Tr Player_Subtitles}" Margin="6,0,0,0" Width="30" Height="30"
                            Visibility="{Binding HasSubtitleTracks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border CornerRadius="4"
                                Background="{Binding SubtitlesEnabled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                            <TextBlock Text="CC" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Button>

                    <ComboBox Grid.Column="6" Style="{StaticResource DarkComboBoxStyle}" Width="140" Margin="8,0,0,0"
                              ItemsSource="{Binding SubtitleTracks}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"
                              Visibility="{Binding HasMultipleSubtitleTracks, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTip="{loc:Tr Player_ChooseSubtitleTrack}" />

                    <!-- Velocidad de reproduccion: util para recorrer tutoriales mas rapido. -->
                    <ComboBox Grid.Column="7" Style="{StaticResource DarkComboBoxStyle}" Width="82" Margin="8,0,0,0"
                              ItemsSource="{Binding PlaybackSpeeds}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedPlaybackSpeed, Mode=TwoWay}"
                              ToolTip="{loc:Tr Player_PlaybackSpeed}" />

                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CurrentTimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                        <TextBlock Text=" / " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalTimeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Aparece en los ultimos 30s: el relleno avanza hasta que el video termina
                         y encadena solo con el siguiente. Clic = pasar al siguiente ya mismo. -->
                    <Button Grid.Column="9" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource PlainButtonStyle}" Command="{Binding PlayNextCommand}"
                            ToolTip="{loc:Tr Player_NextVideo}"
                            Visibility="{Binding IsNextFillVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border CornerRadius="6" Height="30" ClipToBounds="True"
                                Background="{StaticResource BgSurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding NextFillPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                                        <ColumnDefinition Width="{Binding NextFillPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Inverse}" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource AccentBrush}" />
                                    <Rectangle Grid.Column="1" Fill="Transparent" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="{loc:Tr Player_Next}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#9654;" FontSize="10" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
