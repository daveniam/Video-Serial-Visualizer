<Window x:Class="VideoSerialVisualizer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:VideoSerialVisualizer.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:VideoSerialVisualizer.ViewModels"
        xmlns:models="clr-namespace:VideoSerialVisualizer.Models"
        mc:Ignorable="d"
        Title="{loc:Tr Settings_Title}" Height="700" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        d:DataContext="{d:DesignInstance Type=vm:FoldersViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr Settings_Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20" />

        <!-- Categorías personalizadas -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{loc:Tr Settings_Categories}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button HorizontalAlignment="Right" Style="{StaticResource PlainButtonStyle}" Command="{Binding AddCategoryCommand}">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="12,6">
                    <TextBlock Text="{loc:Tr Settings_NewCategory}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2"
                    Text="{loc:Tr Settings_CategoriesHelp}"
                    Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />

        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Category}">
                        <Border Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="14" Padding="4,4,4,4" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PlainButtonStyle}" Padding="8,4"
                                        Command="{Binding DataContext.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{loc:Tr Category_RenameTitle}">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource PlainButtonStyle}" Margin="2,0,4,0" Padding="6,4"
                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{loc:Tr Category_Delete_Title}">
                                    <TextBlock Text="&#10005;" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Tr Settings_NoCategories}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Categories.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Selector de idioma: la interfaz se traduce al instante, sin reiniciar. -->
        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,18" />
            <TextBlock Text="{loc:Tr Settings_Language}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_LanguageHelp}" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
            <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBoxStyle}" Width="200"
                      HorizontalAlignment="Left" DisplayMemberPath="NativeName"
                      SelectionChanged="Language_SelectionChanged" />
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{loc:Tr Settings_FolderGroups}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Tr Settings_FolderGroupsHelp}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding FolderCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderCardViewModel}">
                            <Border Margin="0,0,0,10" CornerRadius="8" Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}">
                                            <Run Text="{Binding VideoCount, Mode=OneWay}" />
                                            <Run Text="{loc:Tr Common_VideosSuffix}" /><Run Text=" · " />
                                            <Run Text="{Binding FolderPath, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1" Style="{StaticResource PlainButtonStyle}" Margin="10,0,0,0"
                                            Command="{Binding DataContext.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="6" Padding="12,7">
                                            <TextBlock Text="{loc:Tr Common_Rename}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource PlainButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border Background="#3A1F24" CornerRadius="6" Padding="12,7">
                                            <TextBlock Text="{loc:Tr Common_Delete}" Foreground="#FF6B6B" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="7" Margin="0,16,0,0">
            <Button Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Left" Click="About_Click">
                <Border Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="8" Padding="18,9">
                    <TextBlock Text="{loc:Tr Settings_About}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                </Border>
            </Button>

            <Button Style="{StaticResource PlainButtonStyle}" HorizontalAlignment="Right" Click="Close_Click">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="18,9">
                    <TextBlock Text="{loc:Tr Common_Close}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                </Border>
            </Button>
        </Grid>
    </Grid>
</Window>
