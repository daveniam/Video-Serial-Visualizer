<Window x:Class="VideoSerialVisualizer.Views.ReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:VideoSerialVisualizer.Localization"
        xmlns:vm="clr-namespace:VideoSerialVisualizer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
        Title="{loc:Tr Reference_Title}"
        Width="640" Height="420" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="{Binding IsReferenceAlwaysOnTop, Mode=TwoWay}"
        Opacity="{Binding WindowOpacityFraction, Mode=OneWay}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize">
    <!-- AllowsTransparency + WindowStyle=None es la UNICA forma de tener una ventana WPF
         semitransparente (probado: aplicar WS_EX_LAYERED por Win32 sobre una ventana ya creada no
         funciona). Como consecuencia no hay barra de titulo nativa: la de abajo es propia, y de ahi
         se arrastra la ventana. Ver tambien VlcFrameRenderer, que hace que el video sea contenido
         WPF y por eso SI obedece esta transparencia. -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="#CC0E0E12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra propia: arrastra la ventana y aloja los controles. -->
            <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" Padding="8,5"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26"
                                Command="{Binding PlayPauseCommand}" ToolTip="{loc:Tr Player_PlayPause}">
                            <TextBlock Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26" Margin="2,0,0,0"
                                Command="{Binding StepFrameBackwardCommand}" ToolTip="{loc:Tr Player_StepFrameBack}">
                            <TextBlock Text="&lt;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26" Margin="2,0,0,0"
                                Command="{Binding StepFrameForwardCommand}" ToolTip="{loc:Tr Player_StepFrameForward}">
                            <TextBlock Text="&gt;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26" Margin="2,0,0,0"
                                Command="{Binding ToggleLoopCommand}" ToolTip="{loc:Tr Player_Loop}">
                            <Border CornerRadius="4"
                                    Background="{Binding IsLoopEnabled, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                                <Viewbox Width="14" Height="14" Margin="6">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Width="16" Height="16" Margin="4"
                                                 Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" />
                                        <Path Data="M16,2 L20,7 L13,7 Z" Fill="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Button>

                        <Border Width="1" Height="16" Background="{StaticResource BorderSubtleBrush}" Margin="6,0" />

                        <!-- Opacidad de esta ventana. Piso de 20% para no perderla de vista. -->
                        <TextBlock Text="{loc:Tr Player_Opacity}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Grid Width="70" Height="18" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center" Height="4">
                                <Rectangle Fill="{StaticResource SeekTrackBrush}" RadiusX="2" RadiusY="2" />
                            </Grid>
                            <Slider Style="{StaticResource ThinVolumeSliderStyle}" VerticalAlignment="Center"
                                    Minimum="20" Maximum="100" Value="{Binding WindowOpacityPercent, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" ToolTip="{loc:Tr Player_Opacity}" />
                        </Grid>
                        <TextBlock Text="{Binding WindowOpacityText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0" MinWidth="30" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Click-through: los clics pasan de largo a la aplicacion de abajo. Se sale
                             con un atajo global, porque con esto activo tampoco se puede clickear
                             este mismo boton. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26" Margin="0,0,2,0"
                                Command="{Binding ToggleReferenceClickThroughCommand}" ToolTip="{loc:Tr Reference_ClickThrough}">
                            <Border CornerRadius="4"
                                    Background="{Binding IsReferenceClickThrough, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                                <Viewbox Width="13" Height="13" Margin="6">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M5,2 L5,17 L9,13 L12,20 L15,19 L12,12 L17,12 Z"
                                              Fill="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Button>

                        <!-- Pin: mantener siempre encima de las demas ventanas. -->
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26"
                                Command="{Binding ToggleReferenceAlwaysOnTopCommand}" ToolTip="{loc:Tr Reference_AlwaysOnTop}">
                            <Border CornerRadius="4"
                                    Background="{Binding IsReferenceAlwaysOnTop, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#1CA1D0;Transparent}">
                                <Viewbox Width="13" Height="13" Margin="6">
                                    <Path Data="M9,2 L15,2 L14,9 L18,12 L13,12 L13,21 L11,21 L11,12 L6,12 L10,9 Z"
                                          Fill="{StaticResource TextPrimaryBrush}" />
                                </Viewbox>
                            </Border>
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="26" Height="26" Margin="2,0,0,0"
                                Click="Close_Click" ToolTip="{loc:Tr Common_Close}">
                            <TextBlock Text="&#10005;" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- El video. Nunca la ventana nativa aca: siempre imagen WPF, que es lo que permite
                 que la transparencia lo alcance. -->
            <Grid x:Name="VideoArea" Grid.Row="1" Background="Transparent">
                <Image Source="{Binding VideoFrame}" Stretch="Uniform"
                       Visibility="{Binding IsFrameStepActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <Image Source="{Binding FrameStepImage}" Stretch="Uniform"
                       Visibility="{Binding IsFrameStepActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Pista visual de que la esquina se puede arrastrar para redimensionar. El
                     redimensionado real lo resuelve el hook de WM_NCHITTEST (ver el code-behind),
                     que actua antes que WPF; esto es solo para que se descubra. -->
                <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                      IsHitTestVisible="False" Opacity="0.5"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Data="M10,0 L12,0 L12,12 L0,12 L0,10 L10,10 Z M6,4 L8,4 L8,8 L4,8 L4,6 L6,6 Z" />
            </Grid>
        </Grid>
    </Border>
</Window>
