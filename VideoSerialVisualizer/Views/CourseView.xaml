<UserControl x:Class="VideoSerialVisualizer.Views.CourseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:VideoSerialVisualizer.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:VideoSerialVisualizer.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BgPrimaryBrush}"
             d:DataContext="{d:DesignInstance Type=vm:CourseViewModel}">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado: volver, nombre del curso, progreso total y acciones -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BackButtonStyle}" Command="{Binding BackCommand}" Margin="0,0,14,0"
                            VerticalAlignment="Center" ToolTip="{loc:Tr Library_BackToExplore}" />
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Tr Course_Badge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding CourseName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource PlainButtonStyle}" Command="{Binding RenameCourseCommand}" Margin="12,0,0,0"
                            VerticalAlignment="Center" ToolTip="{loc:Tr Course_Rename}">
                        <TextBlock Text="&#9998;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="54,10,0,0"
                            Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Width="200" Height="4" Background="{StaticResource BgSurfaceAltBrush}" VerticalAlignment="Center">
                        <Rectangle Height="4" HorizontalAlignment="Left"
                                   Fill="{Binding AllWatched, Converter={StaticResource CompletadoToBrushConverter}}"
                                   Width="{Binding WatchedPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=200}" />
                    </Grid>
                    <TextBlock Text="{Binding WatchedSummaryText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PillButtonStyle}" Command="{Binding ImportFoldersCommand}" Margin="0,0,10,0"
                        ToolTip="{loc:Tr Course_ImportTooltip}">
                    <Border Background="{StaticResource BgSurfaceAltBrush}" CornerRadius="8" Padding="18,10">
                        <TextBlock Text="{loc:Tr Course_Import}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </Button>
                <Button Command="{Binding ContinueCourseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="18,10">
                        <TextBlock Text="{Binding ContinueButtonText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Estado de la importacion -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <Grid Height="6" Width="320" HorizontalAlignment="Left" Background="{StaticResource BgSurfaceAltBrush}"
                  Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Rectangle Height="6" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3"
                           Width="{Binding ScanProgressPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=320}" />
            </Grid>
        </StackPanel>

        <!-- Curso vacio -->
        <TextBlock Grid.Row="2" Text="{loc:Tr Course_EmptyView}" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"
                   Visibility="{Binding HasGroups, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Grupos del curso, en orden. Un curso tiene pocos grupos: alcanza un WrapPanel comun (sin
             virtualizar), que simplifica reordenar arrastrando. -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderCardViewModel}">
                        <Border Width="240" Height="190" Margin="0,0,20,20" CornerRadius="10" Background="{StaticResource BgSurfaceBrush}"
                                BorderThickness="2" ClipToBounds="True" AllowDrop="True"
                                PreviewMouseLeftButtonDown="Group_PreviewMouseLeftButtonDown" PreviewMouseMove="Group_PreviewMouseMove"
                                DragEnter="Group_DragEnter" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <MenuItem Header="{loc:Tr Explore_RenameGroup}" Style="{StaticResource DarkMenuItemStyle}"
                                              Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Course_UseAsCover}" Style="{StaticResource DarkMenuItemStyle}"
                                              Command="{Binding PlacementTarget.Tag.UseGroupCoverForCourseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Tr Course_RemoveGroup}" Style="{StaticResource DarkMenuItemStyle}"
                                              Command="{Binding PlacementTarget.Tag.RemoveGroupFromCourseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="133" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button Grid.RowSpan="2" Style="{StaticResource PlainButtonStyle}"
                                        Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                                <Grid Grid.Row="0" IsHitTestVisible="False">
                                    <Rectangle Fill="{StaticResource BgSurfaceAltBrush}" />
                                    <TextBlock Text="&#128193;" FontSize="30" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                    <!-- Numero de orden dentro del curso -->
                                    <Border Background="#CC000000" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <TextBlock Text="{Binding Position}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="12,10,12,12" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" />
                                    <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <Grid Height="4" Margin="0,8,0,0" Background="{StaticResource BgSurfaceAltBrush}"
                                          ToolTip="{Binding WatchedTooltip}">
                                        <Rectangle Height="4" HorizontalAlignment="Left"
                                                   Fill="{Binding AllWatched, Converter={StaticResource CompletadoToBrushConverter}}"
                                                   Width="{Binding WatchedPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=212}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
